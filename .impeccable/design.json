 "narrative": {
  "northStar": "The Paint Chip Deck",
  "overview": "Every widget is a paint chip from a hardware-store swatch deck: a flat, matte field of colour with a punched hole, over an ivory label band that names it like a paint (\"Coral Hour · WG 0914\"). The app is the fan deck you shuffle through, and the home screen is the wall you've painted. The system is warm, tactile and confident. The colour does the talking and the type stays calm and exact. It deliberately rejects the category's grid of rounded, glassy, gradient widget tiles.\n\nDensity is widget-honest. A chip answers one question at a glance, then gives one line of context. Flow widgets, study timers and streak strips all use the same anatomy, so a user who has read one chip can read every chip.",
  "keyCharacteristics": [
   "Chip anatomy: a colour field on top or left, an ivory label band holding all text, and a punch hole at the top-left.",
   "Each section keeps its colour everywhere: Student coral, Wellness sage, Aesthetic sand, Tech ink, plus plum for evening and mood.",
   "Hierarchy comes from weight and case: condensed caps labels against grotesk display numerals.",
   "Warm paper ground, flat fields, soft offset shadows. No glass, no gradients."
  ],
  "rules": [
   {
    "name": "The Colour Is Law Rule",
    "body": "A section's colour means that section everywhere: widgets, class blocks, list chips, Live Activities. Never use coral for a wellness element or sage for a class.",
    "section": "colors"
   },
   {
    "name": "The Pure Field Rule",
    "body": "Text never sits on a colour field. The field holds only geometry: the punch hole, a fill bar, a drawn glyph or a control. Every word lives on the ivory label band.",
    "section": "colors"
   },
   {
    "name": "The Theme Stays in the Theme Rule",
    "body": "User-theme hues (Chrome Lilac, Library Oak and so on) appear only in theme pickers and user-themed widgets, never in system chrome.",
    "section": "colors"
   },
   {
    "name": "The Two Sizes Rule",
    "body": "A chip uses at most two type sizes: one label size and one display size. Rank inside a chip comes from weight, case and colour, never a third size.",
    "section": "typography"
   },
   {
    "name": "The Plain Subtitle Rule",
    "body": "No caps labels sit above screen titles. Context goes in a plain body subtitle below the title.",
    "section": "typography"
   },
   {
    "name": "The Paper Rule",
    "body": "No glass, blur or glow. Materials are flat paint on paper, and system materials appear only where iOS itself draws them.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do give every chip a punch hole and keep every word on the label band.",
   "Do use each section's colour for that section only, and plum only for evening and mood.",
   "Do set values in Bricolage Grotesque with tabular numerals, and categories in condensed Archivo caps (11px, +0.08em).",
   "Do use the fan deck when showing a set of chips together.",
   "Do label estimates honestly (\"Est. 1h 10m to full\")."
  ],
  "donts": [
   "Don't put text on a colour field.",
   "Don't use more than two type sizes in one chip.",
   "Don't put caps labels above screen titles; use a plain subtitle below.",
   "Don't use glass, gradients, glow or hard zero-blur shadows.",
   "Don't use coloured left-border stripes for list rows. Use a chip with a real colour block."
  ]
 }
}